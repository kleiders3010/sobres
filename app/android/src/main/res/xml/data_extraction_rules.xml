<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same as backup_rules.xml, for cloud backup and device-to-device transfer.
     Backups stay on without a screen lock too: the file is sealed either way (D30). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="backup/tasks.ktbackup" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="backup/tasks.ktbackup" />
    </device-transfer>
</data-extraction-rules>
